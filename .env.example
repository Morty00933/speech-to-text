# ===========================================
# Speech-to-Text Pipeline Configuration
# ===========================================

# API Configuration
API_PORT=8000
API_KEY=your-secure-api-key-here
RATE_LIMIT=100/minute
MAX_FILE_SIZE_MB=500

# Database
POSTGRES_USER=stt
POSTGRES_PASSWORD=stt_secure_password
POSTGRES_DB=stt
DATABASE_URL=postgresql://stt:stt_secure_password@postgres:5432/stt

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_secure_password
MINIO_BUCKET=stt-audio
MINIO_SECURE=false

# Models Configuration
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
MODEL_CACHE_DIR=/models
DEFAULT_MODEL_SIZE=medium

# Monitoring
GRAFANA_PASSWORD=admin_secure_password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# Worker Configuration
CELERY_CONCURRENCY=1
TASK_TIME_LIMIT=3600
